# As chaves do projeto quadro-visitbraga já estão em lib/firebaseConfig.ts.
# Este ficheiro só é preciso para apontar a app a OUTRO projeto Firebase
# (um de testes, por exemplo). Copia para .env.local e preenche.

# NEXT_PUBLIC_FB_API_KEY=
# NEXT_PUBLIC_FB_AUTH_DOMAIN=
# NEXT_PUBLIC_FB_PROJECT_ID=
# NEXT_PUBLIC_FB_STORAGE_BUCKET=
# NEXT_PUBLIC_FB_SENDER_ID=
# NEXT_PUBLIC_FB_APP_ID=

# Domínio autorizado a escrever na página /gestao
NEXT_PUBLIC_DOMINIO_PERMITIDO=cm-braga.pt
